{
  "name": "dsh-graph",
  "version": "0.1.2-rc.1",
  "private": true,
  "description": "Standalone port of the Maka Agent Graph family (control store, stream core, executor, supervisor tools, wakes, projection, host) for the DeepSeek Harness — durable dependency scheduling with exactly-once claims and supervisor yield/wake.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "check": "pnpm -r --filter './packages/*' check",
    "test": "pnpm -r --filter './packages/*' test",
    "pack:all": "pnpm -r --filter './packages/*' pack"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "deepseek",
    "agent",
    "harness",
    "dsh-plugin",
    "agent-graph",
    "maka",
    "supervisor",
    "scheduling"
  ]
}
